# ─────────────────────────────────────────────────────────────
# NLQ-Engine — Environment Variable Template
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# Required: OpenAI API key for LLM-powered SQL generation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Database (default uses the included SQLite sample DB)
DATABASE_URL=sqlite:///./data/Chinook_Sqlite.db

# JWT authentication settings
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
